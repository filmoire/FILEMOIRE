# Copy to .env.local for local development; never commit secrets.
# Demo is explicitly isolated from the real account workspace.
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
# Use staging only with the private deployment setup in docs/production/FREE-STAGING.md.
DEPLOYMENT_STAGE=production
NEXT_PUBLIC_DEPLOYMENT_STAGE=production
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD=
STAGING_ALLOWED_EMAILS=
# Optional personal manuscripts, independent of paid gift orders.
PERSONAL_DRAFTS_ENABLED=false
# Optional beta limits. Stored media includes PDFs; upload reservations count too.
ACCOUNT_LIMIT=
PROJECT_STORAGE_LIMIT_MB=2048
TOTAL_MEDIA_LIMIT_MB=
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://filemoire:filemoire@127.0.0.1:5432/filemoire
# Use a separate migration role in hosted environments.
MIGRATION_DATABASE_URL=
# Neon supplies this direct URL; migrations use it when no owner URL is set.
DATABASE_URL_UNPOOLED=
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Production requires https, APP_MODE=live, private S3, email and no test adapters.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.private-media
S3_REGION=eu-west-3
S3_BUCKET=
S3_ENDPOINT=
# Neon env pull supplies these aliases; explicit S3_* settings take precedence.
AWS_REGION=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_URL=
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
# Never enable until commercial terms and capacity are confirmed.
COHORT_LIMIT=30
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
PRINT_ENABLED=false
PRINT_API_URL=
PRINT_API_KEY=
PRINT_SPEC_VERSION=
# ISO date/time; sales close when reached.
ORDER_CUTOFF_AT=
ADMIN_EMAILS=
# Only set when your reverse proxy overwrites this header.
TRUSTED_CLIENT_IP_HEADER=
DELETION_GRACE_DAYS=14
APP_TIMEZONE=Europe/Paris
# External launch evidence; leave false until the named reviews are complete.
LEGAL_APPROVED=false
COMMERCIAL_APPROVED=false
PRINT_SPEC_APPROVED=false
