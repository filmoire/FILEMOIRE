{
  "name": "filemoire-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Filémoire — family-story workspace with an isolated interactive demo",
  "scripts": {
    "dev": "node scripts/local/start.mjs",
    "dev:local": "node scripts/local/start.mjs",
    "dev:server": "next dev -p 3000",
    "dev:demo": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "build:html": "node scripts/build-html.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "db:migrate": "tsx scripts/production/migrate.ts",
    "worker": "tsx scripts/production/worker.ts",
    "build:worker": "node scripts/production/build-worker.mjs",
    "check:readiness": "tsx scripts/production/readiness.ts",
    "audit:production": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@fontsource/eb-garamond": "5.2.6",
    "@fontsource/inter": "5.2.6",
    "@hookform/resolvers": "5.2.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb-keyval": "6.2.2",
    "lucide-react": "0.544.0",
    "next": "15.5.27",
    "nodemailer": "10.1.0",
    "otpauth": "9.5.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.62.0",
    "sharp": "0.35.5",
    "sonner": "2.0.7",
    "stripe": "23.0.0",
    "tailwind-merge": "3.3.1",
    "tar-stream": "3.2.2",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/tar-stream": "3.1.5",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.10",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "8.5.30",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.30",
      "postcss-selector-parser": "7.1.6"
    }
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
